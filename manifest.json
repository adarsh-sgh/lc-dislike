{
  "manifest_version": 3,
  "name": "LC Dislike Count",
  "version": "1.0.0",
  "description": "Shows the hidden dislike count next to the dislike button on LeetCode problem pages.",
  "homepage_url": "https://github.com/adarsh-sgh/lc-dislike",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
